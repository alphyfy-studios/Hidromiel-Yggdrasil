---
// src/components/ui/RuneDivider.astro

// Divisor decorativo de runas reutilizable.

// Uso: <RuneDivider runes="ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ" />

interface Props {
  runes?: string;
}

const { runes = "ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ ᚷ ᚹ ᚺ ᚾ ᛁ ᛃ ᛇ ᛈ ᛉ ᛊ ᛏ ᛒ ᛖ ᛗ ᛚ ᛜ ᛞ ᛟ" } =
  Astro.props;
---

<div class="rune-divider" aria-hidden="true">{runes}</div>

<style>
  .rune-divider {
    position: relative;
    isolation: isolate;
    text-align: center;
    letter-spacing: 0.55em;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: var(--gold);
    opacity: 0.72;
    margin-block: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    user-select: none;
    animation: glowPulse 5s ease-in-out infinite;
    -webkit-mask-image: radial-gradient(ellipse 78% 68% at center, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 78% 68% at center, #000 38%, transparent 100%);
  }

  .rune-divider::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(34, 9, 1, 0.28) 25%, rgba(34, 9, 1, 0.28) 75%, transparent);
    filter: blur(18px);
  }
</style>
