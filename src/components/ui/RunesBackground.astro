---
// src/components/RunesBackground.astro
// Fondo de runas flotantes con parallax (mouse + scroll) y lluvia de estrellas.
// Vanilla JS, sin dependencias.
---

<canvas id="runes-bg" aria-hidden="true"></canvas>

<style>
  #runes-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 0%, #1b1530 0%, transparent 60%),
      radial-gradient(ellipse at 50% 100%, #2a1a0a 0%, transparent 55%),
      #07060b;
  }
</style>

<script>
  const canvas = document.getElementById("runes-bg") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const RUNES = "ᚠᚢᚦᚨᚱᚲᚷᚹᚺᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ".split("");
  const GOLD = "232, 176, 74";
  const ICE = "170, 200, 255";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  let w = 0, h = 0;

  // Posición objetivo vs. suavizada (lerp) para un parallax fluido
  const mouse = { x: 0, y: 0, sx: 0, sy: 0 };
  let scrollY = 0, smoothScroll = 0;

  type Rune = {
    x: number; y: number; z: number; ch: string; size: number;
    vy: number; rot: number; vr: number; phase: number; tint: string;
  };
  type Star = { x: number; y: number; len: number; speed: number; alpha: number; z: number };

  let runes: Rune[] = [];
  let stars: Star[] = [];

  function resize() {
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    build();
  }

  function build() {
    const runeCount = Math.round(Math.min(70, (w * h) / 22000));
    runes = Array.from({ length: runeCount }, () => {
      const z = Math.random(); // 0 = lejos, 1 = cerca
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        z,
        ch: RUNES[(Math.random() * RUNES.length) | 0],
        size: 14 + z * 46,
        vy: 0.08 + z * 0.35,
        rot: (Math.random() - 0.5) * 0.6,
        vr: (Math.random() - 0.5) * 0.002,
        phase: Math.random() * Math.PI * 2,
        tint: Math.random() > 0.25 ? GOLD : ICE,
      };
    });

    const starCount = Math.round(Math.min(45, w / 35));
    stars = Array.from({ length: starCount }, () => newStar(true));
  }

  function newStar(randomY = false): Star {
    const z = Math.random();
    return {
      x: Math.random() * (w + 300),
      y: randomY ? Math.random() * h : -40,
      len: 40 + z * 110,
      speed: 2 + z * 5,
      alpha: 0.15 + z * 0.55,
      z,
    };
  }

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX / w - 0.5;
    mouse.y = e.clientY / h - 0.5;
  });
  window.addEventListener("scroll", () => (scrollY = window.scrollY), { passive: true });
  window.addEventListener("resize", resize);

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  let last = performance.now();

  function frame(now: number) {
    const dt = Math.min((now - last) / 16.67, 3); // normalizado a ~60fps
    last = now;
    const t = now / 1000;

    mouse.sx = lerp(mouse.sx, mouse.x, 0.05);
    mouse.sy = lerp(mouse.sy, mouse.y, 0.05);
    smoothScroll = lerp(smoothScroll, scrollY, 0.08);

    ctx.clearRect(0, 0, w, h);

    // Lluvia de estrellas (diagonal, con estela)
    ctx.lineCap = "round";
    for (const s of stars) {
      const dx = -0.45; // inclinación de la caída
      const x2 = s.x + dx * s.len;
      const y2 = s.y - s.len;
      const grad = ctx.createLinearGradient(s.x, s.y, x2, y2);
      grad.addColorStop(0, `rgba(${ICE}, ${s.alpha})`);
      grad.addColorStop(1, `rgba(${ICE}, 0)`);
      ctx.strokeStyle = grad;
      ctx.lineWidth = 0.6 + s.z * 1.4;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(x2, y2);
      ctx.stroke();

      if (!reduceMotion) {
        s.y += s.speed * dt;
        s.x += s.speed * dx * dt;
      }
      if (s.y - s.len > h || s.x < -200) Object.assign(s, newStar());
    }

    // Runas flotantes con parallax por profundidad
    for (const r of runes) {
      if (!reduceMotion) {
        r.y += r.vy * dt;
        r.rot += r.vr * dt;
      }
      if (r.y > h + 80) {
        r.y = -80;
        r.x = Math.random() * w;
      }

      const px = r.x + mouse.sx * -90 * r.z;
      const py = r.y + mouse.sy * -60 * r.z - smoothScroll * 0.25 * r.z;
      const wrappedY = ((py % (h + 160)) + (h + 160)) % (h + 160) - 80;

      // Parpadeo suave (respiración de brillo)
      const pulse = 0.55 + 0.45 * Math.sin(t * 0.8 + r.phase);
      const alpha = (0.08 + r.z * 0.4) * pulse;

      ctx.save();
      ctx.translate(px, wrappedY);
      ctx.rotate(r.rot);
      ctx.font = `${r.size}px serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.shadowColor = `rgba(${r.tint}, ${alpha})`;
      ctx.shadowBlur = 8 + r.z * 22;
      ctx.fillStyle = `rgba(${r.tint}, ${alpha})`;
      ctx.fillText(r.ch, 0, 0);
      ctx.restore();
    }

    requestAnimationFrame(frame);
  }

  resize();
  requestAnimationFrame(frame);
</script>