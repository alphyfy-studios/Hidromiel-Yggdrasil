---
// src/components/ui/SectionHeader.astro
// Encabezado de sección reutilizable con label, título y subtítulo.

interface Props {
  label: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { label, title, subtitle, centered = false } = Astro.props;
---

<div class:list={["section-header", { centered }]}>
  <span class="section-label">{label}</span>
  <!-- set:html para soportar <br> en el título -->
  <h2 class="section-title" set:html={title} />
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</div>
