---
// src/components/ui/ProductCard.astro
// Tarjeta individual de producto para la galería.

import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class:list={["gallery-card", { featured: product.featured }]}
  data-product-card
  data-product-image={product.image}
  data-product-name={product.name}
  data-product-coming={product.id === "Berserker" ? "true" : "false"}
  tabindex={product.image ? "0" : undefined}
  role={product.image ? "button" : undefined}
  aria-haspopup={product.image ? "dialog" : undefined}
  aria-label={product.image ? `Ampliar imagen de ${product.name}` : undefined}
>
  <div class="card-img-wrap">
    {product.image
      ? <img src={product.image} alt={product.name} loading="lazy" width="800" height="600" />
      : (
          <div class="placeholder-inner">
            <span class="placeholder-rune">{product.rune}</span>
            <span class="placeholder-label">Imagen del producto</span>
          </div>
        )
    }
    {product.id === "Berserker" && <span class="coming-ribbon">PROXIMAMENTE</span>}
    <div class="card-overlay">
      <span class="card-tag">{product.tag}</span>
    </div>
  </div>

  <div class="card-body">
    <h3 class="card-title">{product.name} </h3>
    <h4 class="card-subtitle">{product.subtitle}</h4>
    <p class="card-desc">{product.description}</p>
     <p class="card-desc">{product.description2}</p>
  </div>
</article>

<style>
  .gallery-card {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    border: 1px solid rgba(246,170,28,0.1);
    background: var(--dark1);
    cursor: pointer;
    transition: border-color 0.35s, transform 0.35s;
  }
  .gallery-card:hover {
    border-color: rgba(246,170,28,0.4);
    transform: translateY(-5px);
  }
  .gallery-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .gallery-card.featured { grid-column: span 2; }

  .card-img-wrap {
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, var(--dark1) 0%, var(--dark2) 100%);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }

  .gallery-card.featured .card-img-wrap { aspect-ratio: 16/9; }

  .card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .coming-ribbon {
    position: absolute;
    z-index: 2;
    top: 43%;
    left: -8%;
    width: 116%;
    padding: .5rem .8rem;
    transform: rotate(-7deg);
    border-block: 1px solid rgba(255, 235, 196, .9);
    background: linear-gradient(100deg, #74140e, #bd3421 45%, #74140e);
    box-shadow: 0 3px 14px #000b;
    color: #fff0d5;
    font: 700 clamp(.8rem, 1.5vw, 1.15rem) var(--font-heading);
    letter-spacing: .18em;
    text-align: center;
    text-shadow: 0 2px 4px #270500;
    pointer-events: none;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    opacity: 0.45;
    transition: opacity 0.35s;
  }
  .gallery-card:hover .placeholder-inner { opacity: 0.7; }

  .placeholder-rune {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--gold);
  }

  .placeholder-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--white);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(34,9,1,0.4) 50%, transparent 100%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.4rem;
    transition: opacity 0.35s;
  }
  .gallery-card:hover .card-overlay { opacity: 1; }

  .card-tag {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.3rem;
  }

  .card-body {
    padding: 1.1rem 1.1rem 1.3rem;
  }

  .card-title {
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    color: var(--white);
    margin-bottom: 0.35rem;
  }
    .card-subtitle {
      text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(0.6rem, 2vw, 0.85rem);
    /* color: var(--white); */
    color: chocolate;
    margin-bottom: 0.35rem;
  }

  .card-desc {
    text-align: center;
    font-size: 1.2rem;
    color: rgba(255,255,255,0.55);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .gallery-card.featured { grid-column: span 2; }
  }
  @media (max-width: 550px) {
    .gallery-card.featured { grid-column: span 1; }
  }
</style>
