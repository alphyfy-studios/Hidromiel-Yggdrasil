---
// src/components/sections/About.astro
// Sección "Nuestra Saga" con texto de historia y los cuatro pilares.
import { testimonials } from "../../data/testimonials";

const pillars = [
  {
    rune: "ᚠ",
    title: "PEDRO PEREZ",
    body: "Me.",
  },
  {
    rune: "ᚷ",
    title: "Don",
    body: "Cada botella, un regalo a quienes aprecian lo genuino y artesanal.",
  },
  {
    rune: "ᛏ",
    title: "Victoria",
    body: "Ganadores de múltiples certámenes de bebidas fermentadas artesanales.",
  },
  {
    rune: "ᛟ",
    title: "Herencia",
    body: "Recetas inspiradas en el Futhark Antiguo y las tradiciones del norte.",
  },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <div class="section-header">
          <span class="section-label">ᛟ · Nuestra Saga</span>
          <h2 class="section-title">Donde la leyenda<br />Cobra Vida</h2>
        </div>
        <p>
          El Hidromiel s la bebida más antigua, sublime y natural de todo el mundo. Una
          bebida diferente, dulce, suave y mágica.<br /><br /> Cada proceso está minuciosamente
          cuidado. Desde la selección del agua, cada fruta, flor, tisana o especia
          escogida por su sabor, aroma y propiedades. Miel 100% de abeja, el cuerpo y alma del Hidromiel.
        </p>

        <a href="#gallery" class="btn btn-primary" style="margin-top:1rem;"
          >Ver Productos</a
        >
      </div>

    <div class="foto_latas"></div>

    <!-- <div class="about-pillars">

      {
        pillars.map(({ rune, title, body }) => (
        <div class="pillar">
          <span class="pillar-rune">{rune}</span>
          <p class="pillar-title">{title}</p>
          <p>{body}</p>
          </div>
          ))
          }
          </div> -->
        
        </div>
      </div>
      <div class="saga-grid">
        {testimonials.map(({ author, role, location, text, stars = 5 }) => (
          <article class="saga-card">
            <div class="saga-stars" aria-label={`${stars} estrellas`}>
              {"★".repeat(stars)}
            </div>
            <p class="saga-text">"{text}"</p>
            <footer class="saga-author">
              {author}
              <span>{role} · {location}</span>
            </footer>
          </article>
        ))}
      </div>
</section>

<style>
  #about {
    background: linear-gradient(
      160deg,
      var(--dark1) 0%,
      var(--black) 50%,
      var(--dark1) 100%
    );
    position: relative;
    overflow: hidden;
  }

  #about::before {
    content: "ᛟ";
    position: absolute;
    right: -4%;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(12rem, 30vw, 26rem);
    color: var(--red1);
    opacity: 0.055;
    pointer-events: none;
    line-height: 1;
  }
.foto_latas {
  background-image: url("/images/products/small_cans.jpg");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  height: 300px; /* Ajusta la altura según necesites */
  width: 100%;
}

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .about-text p {
    margin-bottom: 1.2rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .about-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  .pillar {
    background: linear-gradient(
      135deg,
      rgba(98, 23, 8, 0.25) 0%,
      rgba(34, 9, 1, 0.6) 100%
    );
    border: 1px solid rgba(246, 170, 28, 0.15);
    border-radius: 4px;
    padding: 1.4rem 1.2rem;
    text-align: center;
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .pillar:hover {
    border-color: rgba(246, 170, 28, 0.45);
    transform: translateY(-4px);
  }

  .pillar-rune {
    font-size: 2.2rem;
    color: var(--gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }

  .pillar p:last-child {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  #saga {
    background: var(--black);
    text-align: center;
  }

  .saga-grid {
    display: flex;
    width: 500px;
    margin: auto;
    margin-top: 1.5rem;

    /* display: grid;
    grid-template-columns: repeat(1, 2fr);
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3.5rem); */
  }

  .saga-card {
    background: linear-gradient(145deg, rgba(34,9,1,0.8) 0%, rgba(0,0,0,0.9) 100%);
    border: 1px solid rgba(246,170,28,0.12);
    border-radius: 3px;
    padding: 2rem 1.6rem;
    position: relative;
    overflow: hidden;
    text-align: left;
    transition: border-color 0.3s;
  }
  .saga-card:hover { border-color: rgba(246,170,28,0.35); }

  /* Comilla decorativa de fondo */
  .saga-card::before {
    content: '"';
    font-family: var(--font-display);
    font-size: 8rem;
    color: var(--red1);
    opacity: 0.1;
    position: absolute;
    top: -1.5rem; left: 0.8rem;
    line-height: 1;
    pointer-events: none;
  }

  .saga-stars {
    color: var(--gold);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.8rem;
  }

  .saga-text {
    font-style: italic;
    font-size: 0.92rem;
    color: rgba(255,255,255,0.72);
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  .saga-author {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .saga-author span {
    display: block;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.08em;
    font-size: 0.65rem;
    margin-top: 0.15rem;
  }

  @media (max-width: 900px) {
    .saga-grid { grid-template-columns: 1fr; }
  }
</style>
