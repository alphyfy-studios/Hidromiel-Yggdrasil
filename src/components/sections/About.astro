---
// Sección "Nuestra Saga" y carrusel de testimonios.
import { testimonials } from "../../data/testimonials";

const pillars = [
  { rune: "ᚠ", title: "Origen", body: "Mead artesanal elaborado con miel de abeja." },
  { rune: "ᚷ", title: "Tradición", body: "Cada botella, un regalo a quienes aprecian lo genuino y artesanal." },
  { rune: "ᛏ", title: "Victoria", body: "Ganadores de múltiples certámenes de bebidas fermentadas artesanales." },
  { rune: "ᛟ", title: "Herencia", body: "Recetas inspiradas en el Futhark Antiguo y las tradiciones del norte." },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <div class="section-header">
          <span class="section-label">ᛟ · Nuestra Saga</span>
          <h2 class="section-title">Donde la leyenda<br />Cobra Vida</h2>
        </div>
        <p>
          El Hidromiel es la bebida más antigua, sublime y natural de todo el mundo. Una
          bebida diferente, dulce, suave y mágica.<br /><br />Cada proceso está minuciosamente
          cuidado. Desde la selección del agua, cada fruta, flor, tisana o especia
          escogida por su sabor, aroma y propiedades. Miel 100% de abeja, el cuerpo y alma del Hidromiel.
        </p>
        <a href="#gallery" class="btn btn-primary" style="margin-top:1rem;">Comprar ahora</a>
      </div>
      <div class="foto_latas" role="img" aria-label="Latas de hidromiel Yggdrasil"></div>
    </div>

    <div class="about-pillars">
      {pillars.map(({ rune, title, body }) => (
        <article class="pillar">
          <span class="pillar-rune" aria-hidden="true">{rune}</span>
          <h3 class="pillar-title">{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>

    <div class="saga-heading">
      <span class="section-label">ᛊ · Voces de nuestra comunidad</span>
      <h3 class="section-title">Crónicas de los Valientes</h3>
    </div>

    <div class="saga-carousel" data-saga-carousel aria-roledescription="carrusel" aria-label="Opiniones de clientes">
      <div class="saga-stage" aria-live="polite">
        {testimonials.map(({ author, role, location, text, stars = 5 }, index) => (
          <article class={`saga-card ${index === 0 ? "is-center" : ""}`} data-card-index={index} aria-label={`${index + 1} de ${testimonials.length}`}>
            <div class="saga-stars" aria-label={`${stars} estrellas`}> {"★".repeat(stars)} </div>
            <p class="saga-text">“{text}”</p>
            <footer class="saga-author">{author}<span>{role} · {location}</span></footer>
          </article>
        ))}
      </div>
      <div class="saga-controls">
        <button class="saga-arrow" type="button" data-previous aria-label="Opinión anterior">←</button>
        <span class="saga-position" data-position>1 / {testimonials.length}</span>
        <button class="saga-arrow" type="button" data-next aria-label="Opinión siguiente">→</button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-saga-carousel]").forEach((carousel) => {
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>("[data-card-index]"));
    const position = carousel.querySelector<HTMLElement>("[data-position]");
    let active = 0;

    const render = () => {
      cards.forEach((card, index) => {
        const offset = (index - active + cards.length) % cards.length;
        card.classList.toggle("is-center", offset === 0);
        card.classList.toggle("is-right", offset === 1);
        card.classList.toggle("is-left", offset === cards.length - 1);
        card.classList.toggle("is-hidden", offset > 1 && offset < cards.length - 1);
        card.setAttribute("aria-hidden", offset === 0 ? "false" : "true");
      });
      if (position) position.textContent = `${active + 1} / ${cards.length}`;
    };

    carousel.querySelector("[data-previous]")?.addEventListener("click", () => {
      active = (active - 1 + cards.length) % cards.length;
      render();
    });
    carousel.querySelector("[data-next]")?.addEventListener("click", () => {
      active = (active + 1) % cards.length;
      render();
    });
    render();
  });
</script>

<style>
  #about {
    background: linear-gradient(160deg, rgba(34,9,1,.84) 0%, rgba(0,0,0,.86) 50%, rgba(34,9,1,.84) 100%);
    position: relative;
    overflow: hidden;
  }
  #about::before {
    content: "ᛟ";
    position: absolute;
    right: -4%; top: 42%; transform: translateY(-50%);
    font-size: clamp(12rem, 30vw, 26rem); color: var(--red1); opacity: .08;
    pointer-events: none; line-height: 1;
  }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .about-text p { margin-bottom: 1.2rem; color: rgba(255,255,255,.78); }
  .foto_latas { background: url("/images/products/small_cans.jpg") center / contain no-repeat; min-height: 300px; width: 100%; }
  .about-pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .pillar { background: linear-gradient(135deg, rgba(98,23,8,.35), rgba(34,9,1,.65)); border: 1px solid rgba(246,170,28,.15); padding: 1.3rem 1rem; text-align: center; }
  .pillar-rune { display: block; color: var(--gold); font-size: 2rem; }
  .pillar-title { color: var(--gold); font: .78rem var(--font-heading); letter-spacing: .15em; text-transform: uppercase; margin: .4rem 0; }
  .pillar p { color: rgba(255,255,255,.65); font-size: .85rem; }
  .saga-heading { text-align: center; margin: clamp(4rem, 8vw, 7rem) 0 2rem; }
  .saga-heading .section-title { font-size: clamp(1.6rem, 4vw, 2.5rem); }
  .saga-carousel { max-width: 850px; margin-inline: auto; }
  .saga-stage { position: relative; height: 300px; }
  .saga-card {
    position: absolute; top: 50%; left: 50%; width: min(70%, 540px); min-height: 250px;
    padding: 2rem 1.6rem; overflow: hidden; text-align: left;
    background: linear-gradient(145deg, rgba(55,15,5,.96), rgba(0,0,0,.97));
    border: 1px solid rgba(246,170,28,.2); border-radius: 3px;
    opacity: 0; pointer-events: none; z-index: 0;
    transform: translate(-50%, -50%) scale(.78);
    transition: transform .45s ease, opacity .45s ease, border-color .3s;
  }
  .saga-card.is-center { opacity: 1; pointer-events: auto; z-index: 2; transform: translate(-50%, -50%) scale(1); border-color: rgba(246,170,28,.55); }
  .saga-card.is-left { opacity: .48; z-index: 1; transform: translate(-105%, -50%) scale(.82); }
  .saga-card.is-right { opacity: .48; z-index: 1; transform: translate(5%, -50%) scale(.82); }
  .saga-card::before { content: '“'; position: absolute; top: -1.5rem; left: .8rem; font: 8rem var(--font-display); color: var(--red1); opacity: .16; pointer-events: none; }
  .saga-stars { color: var(--gold); font-size: .85rem; letter-spacing: .1em; margin-bottom: .8rem; }
  .saga-text { color: rgba(255,255,255,.78); font-size: .92rem; font-style: italic; line-height: 1.6; margin-bottom: 1.2rem; }
  .saga-author { color: var(--gold); font: .72rem var(--font-heading); letter-spacing: .14em; text-transform: uppercase; }
  .saga-author span { display: block; color: rgba(255,255,255,.48); font-size: .65rem; letter-spacing: .08em; margin-top: .2rem; }
  .saga-controls { display: flex; align-items: center; justify-content: center; gap: 1.4rem; margin-top: .8rem; }
  .saga-arrow { width: 2.7rem; height: 2.7rem; border: 1px solid rgba(246,170,28,.5); background: rgba(34,9,1,.8); color: var(--gold); font-size: 1.3rem; cursor: pointer; transition: background .2s, color .2s; }
  .saga-arrow:hover, .saga-arrow:focus-visible { background: var(--gold); color: var(--black); }
  .saga-position { color: rgba(255,255,255,.6); font: .7rem var(--font-heading); letter-spacing: .12em; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } .about-pillars { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .saga-stage { height: 340px; }
    .saga-card { width: 82%; min-height: 275px; padding: 1.6rem 1.2rem; }
    .saga-card.is-left { transform: translate(-90%, -50%) scale(.78); }
    .saga-card.is-right { transform: translate(-10%, -50%) scale(.78); }
  }
  @media (prefers-reduced-motion: reduce) { .saga-card { transition: none; } }
</style>
