---
// src/components/sections/Footer.astro
// Footer con columna de marca, contacto y navegación + redes sociales.

import { footerNavLinks } from "../../data/navigation";

const contacts = [
  // {
  //   role: "Maestro Cervecero",
  //   name: 'Eiríkr "El Fermentador" Gómez',
  //   email: "maestro@yggdrasilmeadery.mx",
  // },
  {
    role: "Correo",
    // name: "Sigrid Ruiz",
    email: "ventas@yggdrasilmeadery.mx",
  },
];

const socials = [
  {
    label: "Instagram",
    href: "#",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>`,
  },
  {
    label: "Facebook",
    href: "#",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: "TikTok",
    href: "#",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.17 8.17 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>`,
  },
  // {
  //   label: "YouTube",
  //   href: "#",
  //   svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>`,
  // },
  {
    label: "WhatsApp",
    href: "#",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
];
---

<footer id="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- ── Columna de marca ── -->
      <div class="footer-brand">
        <a href="#hero" class="logo-wrap" aria-label="Yggdrasil Meadery inicio">
            <div class="logo-text">
            <strong>Hidromiel Yggdrasil <span class="com">co.</span> </strong>
            <!-- <p class="company">co.</p> -->
            <!-- <span>Meadery · Est. MMXX</span> -->
          </div>
          <div class="logo-placeholder"></div>
         
        </a>
<p>
          "La bebida de los dioses, elaborada por manos mortales. <br>Cada sorbo es
          un viaje por los nueve mundos."
        </p>
       

        <div class="social-links">
          {
            socials.map(({ label, href, svg }) => (
              <a
                href={href}
                class="social-link"
                aria-label={label}
                title={label}
                set:html={svg}
              />
            ))
          }
        </div>
      </div>

      <!-- ── Columna de contacto ── -->
      <div>
        <h3 class="footer-col-title">ᚲ · Contacto</h3>
        <ul class="contact-list">
          {
            contacts.map(({ role, name, email }) => (
              <li class="contact-item">
                <span class="contact-role">{role}</span>
                <span class="contact-name">{name}</span>
                <a href={`mailto:${email}`}>{email}</a>
              </li>
            ))
          }
          <li class="contact-item">
            <span class="contact-role">Teléfono</span>
            <a href="tel:+5215512345678">+52 (55) 1234 5678</a>
          </li>
          <li class="contact-item">
            <span class="contact-role">Ubicación</span>
            <span class="contact-location">Guadalajara Jalisco, México</span>
          </li>
        </ul>
      </div>

      <!-- ── Columna de navegación ── -->
      <div>
        <h3 class="footer-col-title">ᚷ · Navegación</h3>
        <ul class="footer-nav-links">
          {
            footerNavLinks.map(({ label, href }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} Hidromiel Yggdrasil  · Todos los derechos reservados
        · Beber con moderación.
      </p>
      <p class="footer-runes" aria-hidden="true">ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ</p>
      <p>Diseñado bajo las estrellas del Norte.</p>
    </div>
  </div>
</footer>

<style>
  #footer {
    background: linear-gradient(180deg, var(--dark1) 0%, var(--black) 100%);
    border-top: 1px solid rgba(246, 170, 28, 0.15);
    padding-top: var(--section-pad);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Logo dentro del footer */
  .logo-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .logo-placeholder {
    width: 230px;
    height: 230px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    color: var(--gold);
    /* background: radial-gradient(circle, var(--dark1) 0%, var(--black) 100%); */
    background-image: url("/public/images/logoYGG.png");
    background-size: contain;
    box-shadow: 0 0 14px rgba(246, 170, 28, 0.3);
    flex-shrink: 0;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .logo-text strong {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    color: var(--gold);
    letter-spacing: 0.06em;
  }
  .logo-text span {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    color: var(--white);
    opacity: 0.6;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
 .footer-brand{
  width: 300px;
 }
  .footer-brand > p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
    max-width: 300px;
    text-align: center;
  /* border-width: 5px;
border-style: solid; /* 
border-color: red; */
  }

  /* Redes sociales */
  .social-links {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .social-link {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(246, 170, 28, 0.25);
    border-radius: 2px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.55);
    transition:
      border-color 0.25s,
      color 0.25s,
      background 0.25s;
  }
  .social-link:hover {
    border-color: var(--gold);
    color: var(--gold);
    background: rgba(246, 170, 28, 0.08);
  }

  /* Encabezado de columna */
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(246, 170, 28, 0.2);
  }

  /* Lista de contacto */
  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact-item .contact-role {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red2);
    display: block;
    margin-bottom: 0.2rem;
  }
  /* .contact-item .contact-name {
   font-size: 1.2rem;
    color: var(--white);
    display: block;
    margin-bottom: 0.15rem;
  } */
  .contact-item .contact-location {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .contact-item a {
    font-size:1.2rem;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.25s;
  }
  .contact-item a:hover {
    color: var(--gold);
  }

  /* Nav links del footer */
  .footer-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-nav-links a {
    font-size: 1.4rem;
    color: rgba(255, 255, 255, 0.55);
    transition:
      color 0.25s,
      padding-left 0.25s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-nav-links a::before {
    content: "ᚱ";
    color: var(--red2);
    font-size: 0.75rem;
  }
  .footer-nav-links a:hover {
    color: var(--gold);
    padding-left: 4px;
  }

  /* Barra inferior */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-block: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .footer-bottom p {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.3);
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
  }
  .footer-runes {
    font-size: 1rem;
    color: var(--gold);
    opacity: 0.35;
    letter-spacing: 0.4em;
  }
  .com{
    font-size: 0.9rem;
        color: var(--gold);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 550px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
