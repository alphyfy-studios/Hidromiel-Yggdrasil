---
// src/layouts/Layout.astro
// Layout principal: inyecta <head>, fuentes, CSS global y el slot de contenido.

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = "Yggdrasil Meadery | Hidromiel Artesanal Vikingo",
  description = "Hidromiel artesanal forjado bajo el árbol del mundo. Fermentado con miel pura y la sabiduría de siglos.",
} = Astro.props;

const isHomePage = Astro.url.pathname === "/";
const isStoriesPage = Astro.url.pathname.replace(/\/$/, "") === "/historiasdelnorte";

import WhatsAppButton from '../components/ui/WhatsAppButton.astro';

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi Sitio Web</title>


    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />

    <title>{title}</title>

    <!-- Favicon placeholder — reemplazar con tu /public/favicon.svg -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: preconnect primero, luego stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=IM+Fell+English:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    {isHomePage && (
      <div class="home-runes" aria-hidden="true">
        <span>ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ ᚷ ᚹ ᚺ ᚾ ᛁ ᛃ ᛇ ᛈ ᛉ ᛊ ᛏ ᛒ ᛖ ᛗ ᛚ ᛜ ᛞ ᛟ</span>
        <span>ᛟ ᛞ ᛜ ᛚ ᛗ ᛖ ᛒ ᛏ ᛊ ᛉ ᛈ ᛇ ᛃ ᛁ ᚾ ᚺ ᚹ ᚷ ᚲ ᚱ ᚨ ᚦ ᚢ ᚠ</span>
        <span>ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ ᚷ ᚹ ᚺ ᚾ ᛁ ᛃ ᛇ ᛈ ᛉ ᛊ ᛏ ᛒ ᛖ ᛗ ᛚ ᛜ ᛞ ᛟ</span>
      </div>
    )}
    <div class="site-content"><slot /></div>

    <!-- Botón flotante de WhatsApp -->
    {!isStoriesPage && <WhatsAppButton 
      phone="52155XXXXXXXX" 
      message="¡Hola! Me interesa cotizar un desarrollo web."/>}
  </body>
</html>

<style is:global>
  /* Importamos el CSS global compilado por Astro */
  @import "../styles/global.css";

  .home-runes {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    overflow: hidden;
    pointer-events: none;
    color: var(--red1);
    opacity: 0.18;
    font: clamp(3.5rem, 12vw, 11rem)/1.2 serif;
    animation: bgDrift 24s ease-in-out infinite alternate;
  }

  .home-runes span { white-space: nowrap; }
  .home-runes span:nth-child(2) { transform: translateX(-8%); }
  .site-content { position: relative; z-index: 1; }
</style>
