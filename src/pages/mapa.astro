---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout
  title="Puntos de venta | Yggdrasil Meadery"
  description="Encuentra dónde probar la hidromiel artesanal de Yggdrasil."
>
  <Header />

  <main class="map-page">
    <section class="map-heading">
      <p class="eyebrow">Encuentra nuestra hidromiel</p>
      <h1>Puntos de venta</h1>
      <p class="intro">
        Explora el mapa y selecciona un pin para consultar los detalles de cada lugar.
      </p>
    </section>

    <section class="location-layout" aria-label="Mapa y detalles de puntos de venta">
      <div class="map-column">
        <div id="map" role="application" aria-label="Mapa interactivo de Guadalajara"></div>
        <p class="map-hint">
          Arrastra para explorar y usa los controles para acercar o alejar. Los pines
          de Yggdrasil permanecen fijos en sus ubicaciones.
        </p>
      </div>

      <aside class="place-panel" aria-live="polite" aria-label="Información del punto de venta seleccionado">
        <p class="panel-eyebrow">ᛟ · Yggdrasil Meadery</p>
        <span class="place-category" id="place-category">Cargando ubicación…</span>
        <h2 id="place-name">Punto de venta</h2>
        <p class="place-description" id="place-description"></p>

        <div class="place-detail">
          <span class="detail-icon" aria-hidden="true">⌖</span>
          <p id="place-address"></p>
        </div>
        <div class="place-detail">
          <span class="detail-icon" aria-hidden="true">◷</span>
          <p><strong>Horario</strong><span id="place-hours"></span></p>
        </div>
        <div class="place-detail">
          <span class="detail-icon" aria-hidden="true">☎</span>
          <p><strong>Teléfono</strong><span id="place-phone"></span></p>
        </div>
        <div class="place-coordinates" id="place-coordinates"></div>
        <button class="center-button" id="center-place" type="button">
          Centrar mapa en este pin <span aria-hidden="true">↗</span>
        </button>
      </aside>
    </section>

    <p class="map-note">
      <span aria-hidden="true">ᚠ</span>
      Los datos de esta página se editan en <code>src/data/locations.ts</code>.
    </p>
  </main>

  <Footer />
</Layout>

<script>
  import "leaflet/dist/leaflet.css";
  import L from "leaflet";
  import { salesLocations } from "../data/locations";

  const initialCenter: [number, number] = [20.6769, -103.3475];
  const map = L.map("map", { scrollWheelZoom: true }).setView(initialCenter, 15);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  const name = document.querySelector<HTMLElement>("#place-name");
  const category = document.querySelector<HTMLElement>("#place-category");
  const description = document.querySelector<HTMLElement>("#place-description");
  const address = document.querySelector<HTMLElement>("#place-address");
  const hours = document.querySelector<HTMLElement>("#place-hours");
  const phone = document.querySelector<HTMLElement>("#place-phone");
  const coordinates = document.querySelector<HTMLElement>("#place-coordinates");
  const centerButton = document.querySelector<HTMLButtonElement>("#center-place");
  let selectedLocation = salesLocations[0];

  function showLocation(location: (typeof salesLocations)[number]) {
    selectedLocation = location;
    if (name) name.textContent = location.name;
    if (category) category.textContent = location.category;
    if (description) description.textContent = location.description;
    if (address) address.textContent = location.address;
    if (hours) hours.textContent = location.hours;
    if (phone) phone.textContent = location.phone;
    if (coordinates) {
      coordinates.textContent = `Coordenadas: ${location.coordinates[0].toFixed(5)}, ${location.coordinates[1].toFixed(5)}`;
    }
  }

  const pinIcon = L.divIcon({
    className: "yggdrasil-pin-wrap",
    html: '<span class="yggdrasil-pin" aria-hidden="true">ᛟ</span>',
    iconSize: [36, 46],
    iconAnchor: [18, 43],
  });

  salesLocations.forEach((location) => {
    const marker = L.marker(location.coordinates, {
      icon: pinIcon,
      title: location.name,
      alt: location.name,
      keyboard: true,
      riseOnHover: true,
    }).addTo(map);

    marker.on("click", () => showLocation(location));
  });

  centerButton?.addEventListener("click", () => {
    map.flyTo(selectedLocation.coordinates, Math.max(map.getZoom(), 16), { duration: 0.7 });
  });

  if (salesLocations.length > 1) {
    const bounds = L.latLngBounds(salesLocations.map(({ coordinates: point }) => point));
    map.fitBounds(bounds.pad(0.25), { maxZoom: 15 });
  }

  if (salesLocations[0]) showLocation(salesLocations[0]);
</script>

<style>
  .map-page {
    --gold: #d5ad65;
    --gold-light: #f0d79d;
    --panel: rgba(25, 20, 15, 0.94);
    --muted: #c1b9a6;
    max-width: 1320px;
    margin: 0 auto;
    padding: 5rem 1.5rem 5rem;
    color: #f5efdf;
  }

  .map-heading { max-width: 760px; margin: 0 auto 2.5rem; text-align: center; }
  .eyebrow, .panel-eyebrow {
    margin: 0 0 .7rem; color: var(--gold); font-size: .75rem;
    font-weight: 700; letter-spacing: .22em; text-transform: uppercase;
  }
  .map-heading h1 {
    margin: 0; color: var(--gold-light); font-family: var(--font-display, Georgia, serif);
    font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1.08; text-shadow: 0 3px 24px #0009;
  }
  .intro { max-width: 620px; margin: 1rem auto 0; color: var(--muted); line-height: 1.7; }
  .location-layout {
    display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, .85fr);
    min-height: 560px; overflow: hidden; border: 1px solid rgba(213,173,101,.65);
    border-radius: 12px; background: var(--panel); box-shadow: 0 20px 60px #0008;
  }
  .map-column { min-width: 0; display: flex; flex-direction: column; }
  #map { flex: 1; min-height: 500px; background: #29271f; }
  .map-hint { margin: 0; padding: .85rem 1rem; color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .place-panel {
    display: flex; flex-direction: column; align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.3rem); border-left: 1px solid rgba(213,173,101,.25);
    background: linear-gradient(155deg, rgba(50,25,12,.8), rgba(15,13,10,.96) 72%);
  }
  .place-panel .panel-eyebrow { margin-bottom: 1.5rem; }
  .place-category {
    display: inline-block; margin-bottom: .7rem; border: 1px solid rgba(213,173,101,.4);
    border-radius: 99px; padding: .35rem .65rem; color: var(--gold-light);
    font-size: .68rem; letter-spacing: .04em; line-height: 1.4;
  }
  .place-panel h2 { margin: 0 0 .7rem; color: #fff8e9; font: 700 clamp(1.45rem, 2.5vw, 1.9rem)/1.2 var(--font-heading, Georgia, serif); }
  .place-description { margin: 0 0 1.6rem; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .place-detail { display: grid; grid-template-columns: 1.5rem 1fr; gap: .75rem; width: 100%; margin: .7rem 0; color: #ede5d3; }
  .detail-icon { color: var(--gold); font-size: 1.25rem; text-align: center; }
  .place-detail p { margin: 0; font-size: .9rem; line-height: 1.55; }
  .place-detail strong, .place-detail p > span { display: block; }
  .place-detail strong { margin-bottom: .15rem; color: var(--gold-light); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
  .place-coordinates { margin: auto 0 1rem 2.25rem; padding-top: 1rem; color: rgba(255,255,255,.42); font: .68rem/1.5 ui-monospace, monospace; }
  .center-button {
    display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1rem;
    border: 1px solid var(--gold); border-radius: 4px; padding: .8rem 1rem;
    background: rgba(213,173,101,.1); color: var(--gold-light); font: .72rem var(--font-heading, Georgia, serif);
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: background .2s, color .2s;
  }
  .center-button:hover, .center-button:focus-visible { background: var(--gold); color: #17130e; }
  .map-note { margin: 1.2rem 0 0; color: var(--muted); text-align: center; font-size: .85rem; }
  .map-note > span { margin-right: .4rem; color: var(--gold); }
  .map-note code { color: var(--gold-light); }

  @media (max-width: 850px) {
    .location-layout { grid-template-columns: 1fr; }
    #map { flex: initial; height: min(60vh, 520px); min-height: 380px; }
    .place-panel { border-left: 0; border-top: 1px solid rgba(213,173,101,.25); }
    .place-coordinates { margin-top: 1rem; }
  }
  @media (max-width: 600px) { .map-page { padding: 3rem 1rem; } #map { min-height: 350px; } }
</style>

<style is:global>
  .yggdrasil-pin-wrap { background: transparent; border: 0; }
  .yggdrasil-pin {
    display: grid; width: 36px; height: 36px; place-items: center; position: relative;
    border: 2px solid #f0d79d; border-radius: 50% 50% 50% 4px; transform: rotate(-45deg);
    background: #941b0c; color: #f6aa1c; box-shadow: 0 3px 12px #0009;
    font: 1.1rem Georgia, serif;
  }
  .yggdrasil-pin::first-letter { transform: rotate(45deg); }
  .leaflet-control-zoom a { background: #211f19 !important; color: #f0d79d !important; border-color: #8e744d !important; }
  .leaflet-control-attribution { font-size: 9px !important; }
</style>
