---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
---

<Layout
  title="Puntos de venta | Yggdrasil Meadery"
  description="Encuentra dónde probar la hidromiel artesanal de Yggdrasil."
>
  <Header />

  <main class="map-page">
    <section class="map-heading">
      <p class="eyebrow">Encuentra nuestra hidromiel</p>
      <h1>Los caminos de Yggdrasil</h1>
      <p class="intro">
        Explora nuestros puntos de venta o agrega un marcador en el mapa.
        Haz clic sobre el mapa para colocar uno.
      </p>
    </section>

    <section class="map-card" aria-label="Mapa interactivo de puntos de venta">
      <div class="map-toolbar">
        <span class="map-status" id="map-status">Preparando el mapa…</span>
        <button class="clear-button" id="clear-markers" type="button">
          Borrar mis marcadores
        </button>
      </div>
      <div id="map" role="application" aria-label="Mapa interactivo"></div>
      <p class="map-hint">
        Haz clic en el mapa para colocar un marcador. Selecciónalo para ver sus
        coordenadas o quitarlo.
      </p>
    </section>

    <p class="map-note">
      <span aria-hidden="true">ᚠ</span>
      Los marcadores que agregues se guardan solo en este navegador.
    </p>
  </main>
</Layout>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script>
  import L from "leaflet";

  type SavedMarker = {
    lat: number;
    lng: number;
  };

  const storageKey = "yggdrasil-meadery-markers";
  const initialCenter: [number, number] = [19.4326, -99.1332]; // Ciudad de México
  const map = L.map("map").setView(initialCenter, 11);
  const markerLayer = L.layerGroup().addTo(map);
  const status = document.querySelector<HTMLElement>("#map-status");
  const clearButton = document.querySelector<HTMLButtonElement>("#clear-markers");

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  function readMarkers(): SavedMarker[] {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? "[]");
    } catch {
      return [];
    }
  }

  function saveMarkers(markers: SavedMarker[]) {
    localStorage.setItem(storageKey, JSON.stringify(markers));
  }

  function renderMarkers() {
    markerLayer.clearLayers();

    const markers = readMarkers();
    markers.forEach((point, index) => {
      const marker = L.marker([point.lat, point.lng], { draggable: true })
        .addTo(markerLayer);

      marker.bindPopup(`
        <strong>Punto de venta ${index + 1}</strong><br>
        ${point.lat.toFixed(5)}, ${point.lng.toFixed(5)}<br>
        <button type="button" class="popup-remove" data-index="${index}">
          Quitar marcador
        </button>
      `);

      marker.on("dragend", () => {
        const position = marker.getLatLng();
        const updated = readMarkers();
        updated[index] = { lat: position.lat, lng: position.lng };
        saveMarkers(updated);
        renderMarkers();
      });
    });

    if (status) {
      status.textContent = markers.length
        ? `${markers.length} marcador${markers.length === 1 ? "" : "es"} en este navegador`
        : "Aún no hay marcadores. Haz clic en el mapa para agregar uno.";
    }
  }

  map.on("click", (event: L.LeafletMouseEvent) => {
    const markers = readMarkers();
    markers.push({ lat: event.latlng.lat, lng: event.latlng.lng });
    saveMarkers(markers);
    renderMarkers();
  });

  map.on("popupopen", (event: L.PopupEvent) => {
    const button = event.popup
      .getElement()
      ?.querySelector<HTMLButtonElement>(".popup-remove");

    button?.addEventListener("click", () => {
      const index = Number(button.dataset.index);
      const markers = readMarkers();
      markers.splice(index, 1);
      saveMarkers(markers);
      map.closePopup();
      renderMarkers();
    });
  });

  clearButton?.addEventListener("click", () => {
    saveMarkers([]);
    renderMarkers();
  });

  renderMarkers();
</script>

<style>
  .map-page {
    --gold: #d5ad65;
    --gold-light: #f0d79d;
    --ink: #171612;
    --panel: #211f19;
    --muted: #c1b9a6;

    max-width: 1180px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    color: #f5efdf;
  }

  .map-heading {
    max-width: 760px;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .map-heading h1 {
    margin: 0;
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1;
    text-shadow: 0 3px 24px #0009;
  }

  .intro {
    max-width: 620px;
    margin: 1rem auto 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .map-card {
    overflow: hidden;
    border: 1px solid #a9854c;
    border-radius: 14px;
    background: var(--panel);
    box-shadow: 0 20px 60px #0007;
  }

  .map-toolbar {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #a9854c66;
  }

  .map-status {
    color: var(--gold-light);
    font-size: 0.9rem;
  }

  .clear-button {
    border: 1px solid #9b7949;
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
    background: #302b21;
    color: #f5efdf;
    cursor: pointer;
  }

  .clear-button:hover {
    background: #413824;
  }

  #map {
    height: min(62vh, 620px);
    min-height: 360px;
    background: #29271f;
  }

  .map-hint {
    margin: 0;
    padding: 0.8rem 1rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .map-note {
    margin: 1rem 0 0;
    color: var(--muted);
    text-align: center;
    font-size: 0.85rem;
  }

  .map-note span {
    margin-right: 0.4rem;
    color: var(--gold);
  }

  @media (max-width: 600px) {
    .map-page {
      padding: 3rem 1rem;
    }

    .map-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    #map {
      min-height: 420px;
    }
  }
</style>

<style is:global>
  .leaflet-popup-content-wrapper,
  .leaflet-popup-tip {
    background: #211f19;
    color: #f5efdf;
  }

  .leaflet-popup-content {
    line-height: 1.8;
  }

  .popup-remove {
    margin-top: 0.35rem;
    border: 1px solid #9b7949;
    border-radius: 4px;
    padding: 0.3rem 0.5rem;
    background: #302b21;
    color: #f5efdf;
    cursor: pointer;
  }
</style>