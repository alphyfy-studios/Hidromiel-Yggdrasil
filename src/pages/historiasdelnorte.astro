  .carta{
    padding: 1.5rem;
    margin: 3rem;
    width: 350px;
    display: flex;
    flex-direction: column;
    border: 3px solid rgb(88, 88, 88);
    border-radius: 3rem;
    background-color: rgb(49, 38, 27);
    justify-content: center;
    align-items: center;
  }
  .titulo{
    background-color: rgb(41, 45, 45);
    padding: 1rem;
  }
</style>

