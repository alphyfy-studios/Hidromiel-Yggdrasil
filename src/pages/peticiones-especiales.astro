---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import { shopProducts } from "../data/shop-products";

const packageSizes = [6, 12, 24] as const;
---

<Layout
  title="Tienda online | Hidromiel Yggdrasil"
  description="Arma tu pedido de hidromiel Yggdrasil y revisa las opciones de pago disponibles."
>
  <Header />

  <main class="shop-page">
    <div class="shop-container">
      <header class="shop-heading">
        <span class="section-label">ᛟ · La tienda de Yggdrasil</span>
        <h1 class="section-title">Tienda <span>Online</span></h1>
        <p>Elige VANIR BLUT, MIDGARD o combina tus sabores favoritos. Cada lata cuesta $85 MXN.</p>
      </header>

      <div class="shop-layout">
        <section class="product-section" aria-label="Presentaciones disponibles">
          {packageSizes.map((size) => <section class="six-builder" data-package-builder data-package-size={size} aria-labelledby={`builder-title-${size}`}>
            <div class="six-builder-heading">
              <span class="builder-rune" aria-hidden="true">ᛟ</span>
              <div>
                <p class="builder-kicker">Tu mezcla, tu saga</p>
                <h2 id={`builder-title-${size}`}>Arma tu paquete de {size}</h2>
                <p>Combina las {size} latas como quieras: VANIR BLUT, MIDGARD o una mezcla.</p>
              </div>
            </div>
            <div class="six-builder-options">
              <div class="flavor-option">
                <span class="flavor-dot is-red" aria-hidden="true"></span>
                <span class="flavor-name">VANIR BLUT <small>Hidromiel Metheglin</small></span>
                <button class="flavor-step" type="button" data-package-flavor="vanir" data-step="-1" aria-label="Quitar una lata VANIR BLUT">−</button>
                <output class="flavor-count" data-count="vanir" aria-live="polite">0</output>
                <button class="flavor-step" type="button" data-package-flavor="vanir" data-step="1" aria-label="Agregar una lata VANIR BLUT">+</button>
              </div>
              <div class="flavor-option">
                <span class="flavor-dot is-yellow" aria-hidden="true"></span>
                <span class="flavor-name">MIDGARD <small>Hidromiel Cyser</small></span>
                <button class="flavor-step" type="button" data-package-flavor="midgard" data-step="-1" aria-label="Quitar una lata MIDGARD">−</button>
                <output class="flavor-count" data-count="midgard" aria-live="polite">0</output>
                <button class="flavor-step" type="button" data-package-flavor="midgard" data-step="1" aria-label="Agregar una lata MIDGARD">+</button>
              </div>
            </div>
            <div class="builder-footer">
              <span data-package-progress role="status" aria-live="polite">0 de {size} latas seleccionadas · ${size * 85} MXN al completar</span>
              <button class="build-six-button" data-build-package type="button" disabled>Armar mi paquete <span aria-hidden="true">→</span></button>
            </div>
          </section>)}
          <div class="product-grid">
            {shopProducts.map((product) => (
              <article class="shop-product">
                <div class="product-image">
                  <img src={product.image} alt={`${product.name}, presentación de ${product.packSize} piezas`} loading="lazy" decoding="async" width="440" height="330" />
                  <span class:list={["product-color", product.color === "Roja" ? "is-red" : "is-yellow"]}>{product.name}</span>
                </div>
                <div class="product-info">
                  <p class="product-pack">Caja con {product.packSize} latas</p>
                  <h2>{product.name}</h2>
                  <p class="product-description">{product.description}</p>
                  <p class="product-price">{new Intl.NumberFormat("es-MX", { style: "currency", currency: "MXN" }).format(product.price)}</p>
                  <button class="add-button" type="button" data-add-to-cart={product.id}>
                    Añadir al carrito <span aria-hidden="true">＋</span>
                  </button>
                </div>
              </article>
            ))}
          </div>
        </section>

        <aside class="cart-panel" aria-labelledby="cart-title">
          <div class="cart-heading">
            <div>
              <p class="cart-kicker">ᚠ · Tu selección</p>
              <h2 id="cart-title">Carrito <span id="cart-count">0</span></h2>
            </div>
            <span class="cart-rune" aria-hidden="true">ᛒ</span>
          </div>

          <p class="cart-empty" id="cart-empty">Tu carrito está esperando su primer brindis.</p>
          <ul class="cart-items" id="cart-items" aria-live="polite"></ul>

          <div class="cart-total-row">
            <span>Subtotal</span>
            <strong id="cart-total">$0.00</strong>
          </div>
          <p class="price-note" id="price-note">Precio unitario: $85 MXN por lata.</p>
          <button class="checkout-button" id="open-checkout" type="button" disabled>
            Proceder a pagar <span aria-hidden="true">→</span>
          </button>
          <p class="cart-security">El pago seguro se habilitará al conectar el proveedor de cobro.</p>
        </aside>
      </div>
    </div>
  </main>

  <dialog class="checkout-dialog" id="checkout-dialog" aria-labelledby="checkout-title">
    <div class="checkout-window">
      <button class="checkout-close" id="close-checkout" type="button" aria-label="Cerrar resumen">&times;</button>
      <p class="checkout-kicker">ᛟ · Antes del siguiente viaje</p>
      <h2 id="checkout-title">Revisa tu pedido</h2>
      <p class="checkout-intro">Confirma los productos y elige cómo te gustaría pagar.</p>

      <ul class="checkout-items" id="checkout-items"></ul>
      <div class="checkout-total"><span>Total</span><strong id="checkout-total">$0.00</strong></div>

      <fieldset class="payment-options">
        <legend>Forma de pago</legend>
        <button class="payment-option" type="button" data-payment-method="paypal" aria-pressed="false">
          <span class="payment-mark paypal-mark" aria-hidden="true">P</span>
          <span><strong>PayPal</strong><small>Pago con tu cuenta PayPal</small></span>
          <span class="payment-check" aria-hidden="true">✓</span>
        </button>
        <button class="payment-option" type="button" data-payment-method="google-pay" aria-pressed="false">
          <span class="payment-mark google-mark" aria-hidden="true">G</span>
          <span><strong>Google Pay</strong><small>Pago rápido con Google Pay</small></span>
          <span class="payment-check" aria-hidden="true">✓</span>
        </button>
        <button class="payment-option" type="button" data-payment-method="card" aria-pressed="false">
          <span class="payment-mark card-mark" aria-hidden="true">▰</span>
          <span><strong>Tarjeta de débito o crédito</strong><small>Los datos se capturarán en el proveedor seguro</small></span>
          <span class="payment-check" aria-hidden="true">✓</span>
        </button>
      </fieldset>

      <p class="checkout-status" id="checkout-status" role="status" aria-live="polite">
        Los precios están listos. El cobro real se habilitará al conectar un proveedor de pagos.
      </p>
      <button class="pay-button" id="pay-order" type="button">Continuar al pago seguro</button>
      <p class="checkout-footnote">No escribas datos de tarjeta en este sitio. El proveedor seguro los solicitará cuando se conecte.</p>
    </div>
  </dialog>

  <dialog class="six-success-dialog" id="six-success-dialog" aria-labelledby="six-success-title" aria-describedby="six-success-message">
    <div class="six-success-window">
      <span class="success-rune" aria-hidden="true">ᛟ</span>
      <p class="success-kicker" id="six-success-title">ᚠ · El pedido está listo</p>
      <p class="success-message" id="six-success-message">Perfecto Vikingo, has armado tu paquete de la bebida de los Dioses</p>
      <p class="success-detail" id="six-success-detail"></p>
      <button class="success-close" id="close-six-success" type="button">Entendido, vikingo</button>
    </div>
  </dialog>

  <Footer />
</Layout>

<style>
  .shop-page {
    position: relative;
    min-height: 75vh;
    padding: 9rem 1.25rem 6rem;
    color: var(--white);
    background:
      radial-gradient(ellipse at 45% 5%, rgba(148,27,12,.22), transparent 48%),
      linear-gradient(180deg, #080706, #1b0b05 48%, #080706);
  }
  .shop-container { max-width: 1320px; margin: 0 auto; }
  .shop-heading { max-width: 720px; margin: 0 auto 3rem; text-align: center; }
  .shop-heading .section-label { margin-bottom: .8rem; }
  .shop-heading .section-title span { display: block; color: var(--gold); }
  .shop-heading > p:last-child { color: rgba(255,255,255,.68); font-size: 1.08rem; font-style: italic; }
  .shop-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(290px, 350px); gap: clamp(1.5rem, 3vw, 2.8rem); align-items: start; }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; }
  .shop-product { overflow: hidden; border: 1px solid rgba(246,170,28,.18); background: linear-gradient(145deg, rgba(46,18,7,.92), rgba(11,9,7,.96)); box-shadow: 0 12px 35px rgba(0,0,0,.3); transition: transform .25s, border-color .25s, box-shadow .25s; }
  .shop-product:hover { transform: translateY(-4px); border-color: rgba(246,170,28,.48); box-shadow: 0 18px 40px rgba(0,0,0,.45); }
  .product-image { position: relative; aspect-ratio: 4/3; overflow: hidden; background: radial-gradient(ellipse, #401809, #100805); }
  .product-image img { display: block; width: 100%; height: 100%; object-fit: contain; padding: .75rem; filter: drop-shadow(0 8px 16px rgba(0,0,0,.5)); }
  .product-color { position: absolute; top: .7rem; left: .7rem; padding: .3rem .55rem; border: 1px solid currentColor; background: rgba(0,0,0,.62); font: .68rem var(--font-heading); letter-spacing: .14em; text-transform: uppercase; }
  .product-color.is-red { color: #e77d63; }
  .product-color.is-yellow { color: #f6cc71; }
  .product-info { padding: 1.1rem; }
  .product-pack { margin: 0 0 .4rem; color: var(--gold); font: .72rem var(--font-heading); letter-spacing: .13em; text-transform: uppercase; }
  .product-info h2 { min-height: 2.8rem; margin: 0; font: 700 1.12rem/1.3 var(--font-heading); }
  .product-description { margin: .35rem 0 .75rem; color: rgba(255,255,255,.62); font-size: .9rem; line-height: 1.5; }
  .product-price { min-height: 1.5rem; margin: 0 0 .85rem; color: #f2dfbb; font: .88rem var(--font-heading); }
  .add-button { display: flex; width: 100%; min-height: 2.9rem; justify-content: space-between; align-items: center; gap: .5rem; border: 1px solid rgba(246,170,28,.65); border-radius: 3px; padding: .78rem .85rem; background: rgba(246,170,28,.08); color: var(--gold); font: .76rem var(--font-heading); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: background .2s, color .2s; }
  .add-button:hover, .add-button:focus-visible { background: var(--gold); color: #1a0c04; }
  .add-button span { font-size: 1.15rem; }

  .six-builder { margin: 0 0 1.5rem; padding: clamp(1.1rem, 2.5vw, 1.65rem); border: 1px solid rgba(246,170,28,.45); background: radial-gradient(ellipse at 0 0, rgba(148,27,12,.28), transparent 55%), linear-gradient(145deg, rgba(44,20,9,.96), rgba(13,10,8,.98)); box-shadow: 0 15px 40px #0006; }
  .six-builder-heading { display: flex; align-items: flex-start; gap: 1rem; }
  .builder-rune { color: var(--gold); font: 2.1rem/1 var(--font-display); text-shadow: 0 0 18px #f6aa1c88; }
  .builder-kicker { margin: 0 0 .3rem; color: var(--gold); font: .66rem var(--font-heading); letter-spacing: .18em; text-transform: uppercase; }
  .six-builder-heading h2 { margin: 0; color: #fff2d7; font: 700 1.45rem/1.2 var(--font-display); }
  .six-builder-heading p:last-child { margin: .35rem 0 0; color: rgba(255,255,255,.62); font-size: .88rem; line-height: 1.5; }
  .six-builder-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin-top: 1.15rem; }
  .flavor-option { display: grid; grid-template-columns: .7rem minmax(0,1fr) 2.35rem 1.5rem 2.35rem; align-items: center; gap: .55rem; min-width: 0; border: 1px solid rgba(255,255,255,.1); padding: .7rem; background: rgba(0,0,0,.24); }
  .flavor-dot { width: .62rem; height: .62rem; border-radius: 50%; }
  .flavor-dot.is-red { background: #df634a; box-shadow: 0 0 12px #df634a88; }
  .flavor-dot.is-yellow { background: #f2c45f; box-shadow: 0 0 12px #f2c45f88; }
  .flavor-name { min-width: 0; color: #fff2d7; font: .75rem var(--font-heading); letter-spacing: .04em; }
  .flavor-name small { display: block; margin-top: .18rem; color: rgba(255,255,255,.53); font: .68rem/1.3 system-ui, sans-serif; letter-spacing: 0; }
  .flavor-step { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; border: 1px solid rgba(246,170,28,.5); border-radius: 3px; background: rgba(246,170,28,.08); color: var(--gold); font: 1.2rem var(--font-heading); cursor: pointer; transition: background .2s, color .2s; }
  .flavor-step:hover, .flavor-step:focus-visible { background: var(--gold); color: #1a0c04; }
  .flavor-step:disabled { opacity: .38; cursor: not-allowed; }
  .flavor-count { color: #fff2d7; font: 700 .95rem var(--font-heading); text-align: center; }
  .builder-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: .9rem; border-top: 1px solid rgba(246,170,28,.2); }
  .builder-footer > span { color: rgba(255,255,255,.72); font-size: .82rem; line-height: 1.45; }
  .build-six-button, .success-close { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.9rem; border: 1px solid var(--gold); padding: .75rem 1rem; background: var(--gold); color: #170b04; font: 700 .76rem var(--font-heading); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: filter .2s, opacity .2s; }
  .build-six-button:hover:not(:disabled), .success-close:hover { filter: brightness(1.12); }
  .build-six-button:disabled { opacity: .42; cursor: not-allowed; }

  .cart-panel { position: sticky; top: 1rem; min-width: 0; padding: clamp(1rem, 2vw, 1.4rem); border: 1px solid rgba(246,170,28,.34); background: linear-gradient(155deg, rgba(40,16,7,.97), rgba(10,9,7,.98)); box-shadow: 0 20px 50px rgba(0,0,0,.4); }
  .cart-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid rgba(246,170,28,.2); }
  .cart-kicker, .checkout-kicker { margin: 0 0 .4rem; color: var(--gold); font: .68rem var(--font-heading); letter-spacing: .18em; text-transform: uppercase; }
  .cart-heading h2 { display: flex; align-items: center; gap: .6rem; margin: 0; font: 700 1.5rem var(--font-display); }
  #cart-count { display: grid; min-width: 1.5rem; height: 1.5rem; place-items: center; border-radius: 50%; background: var(--gold); color: #1a0c04; font: 700 .72rem var(--font-heading); }
  .cart-rune { color: rgba(246,170,28,.7); font-size: 2rem; }
  .cart-empty { margin: 1.25rem 0; color: rgba(255,255,255,.68); font-size: .98rem; font-style: italic; line-height: 1.55; }
  .cart-items, .checkout-items { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .cart-items { max-height: min(48vh, 470px); overflow-y: auto; padding-inline: .1rem; }
  .cart-item { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: .25rem .75rem; align-items: start; padding: .85rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .checkout-item { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto; gap: .65rem; align-items: center; padding: .7rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .cart-item img, .checkout-item img { width: 54px; height: 54px; object-fit: contain; background: rgba(0,0,0,.28); }
  .cart-item > span:nth-child(2), .checkout-item > span:nth-child(2) { min-width: 0; overflow-wrap: anywhere; }
  .cart-item-name, .checkout-item-name { display: block; color: #fff2d7; font: 600 .82rem/1.4 var(--font-heading); }
  .cart-item-meta, .checkout-item-meta { display: block; margin-top: .25rem; color: rgba(255,255,255,.6); font-size: .76rem; line-height: 1.45; }
  .cart-item-price { grid-column: 2; color: var(--gold); font: .78rem var(--font-heading); white-space: nowrap; }
  .checkout-item-price { color: var(--gold); font: .76rem var(--font-heading); white-space: nowrap; }
  .cart-item-controls { display: grid; grid-template-columns: 2.5rem minmax(1.5rem, auto) 2.5rem minmax(4.8rem, 1fr); grid-column: 1 / -1; align-items: center; gap: .55rem; padding-top: .35rem; }
  .quantity-button, .remove-button { display: inline-grid; min-width: 2.5rem; min-height: 2.5rem; place-items: center; border: 1px solid rgba(246,170,28,.48); border-radius: 4px; background: rgba(246,170,28,.08); color: #f3ddb0; font: 1.1rem var(--font-heading); cursor: pointer; transition: background .2s, border-color .2s, color .2s, transform .2s; }
  .quantity-button:hover, .quantity-button:focus-visible { border-color: var(--gold); background: var(--gold); color: #201006; transform: translateY(-1px); }
  .cart-quantity { min-width: 1.5rem; text-align: center; color: #fff2d7; font: 600 .86rem var(--font-heading); }
  .remove-button { justify-self: end; min-width: 4.8rem; padding-inline: .65rem; border-color: rgba(188,57,8,.56); background: rgba(188,57,8,.12); color: #e8a18a; font: 600 .78rem var(--font-heading); letter-spacing: .04em; }
  .remove-button:hover, .remove-button:focus-visible { border-color: #e77d63; background: rgba(188,57,8,.34); color: #fff0e8; }
  .cart-total-row, .checkout-total { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.2rem; padding-top: .95rem; border-top: 1px solid rgba(246,170,28,.32); color: rgba(255,255,255,.82); font: .9rem var(--font-heading); }
  .cart-total-row strong, .checkout-total strong { color: var(--gold); font-size: .95rem; }
  .price-note { min-height: 2.2rem; margin: .65rem 0 1rem; color: rgba(255,255,255,.56); font-size: .78rem; line-height: 1.5; }
  .checkout-button, .pay-button { display: flex; width: 100%; min-height: 3.25rem; justify-content: space-between; align-items: center; gap: .8rem; border: 0; border-radius: 3px; padding: .9rem 1rem; background: var(--gold); color: #170b04; font: 700 .82rem var(--font-heading); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: filter .2s, opacity .2s; }
  .checkout-button:hover:not(:disabled), .pay-button:hover { filter: brightness(1.12); }
  .checkout-button:disabled { opacity: .45; cursor: not-allowed; }
  .cart-security { margin: .85rem 0 0; color: rgba(255,255,255,.5); font-size: .74rem; line-height: 1.5; text-align: center; }

  .checkout-dialog { width: min(560px, calc(100vw - 1.5rem)); max-width: none; max-height: calc(100dvh - 1.5rem); margin: auto; padding: 0; overflow: auto; border: 1px solid rgba(246,170,28,.42); background: #160c07; color: white; box-shadow: 0 25px 90px rgba(0,0,0,.72); }
  .checkout-dialog::backdrop { background: rgba(0,0,0,.78); backdrop-filter: blur(6px); }
  .checkout-window { position: relative; padding: clamp(1.3rem, 4vw, 2rem); }
  .checkout-close { position: absolute; top: .8rem; right: .9rem; width: 2rem; height: 2rem; border: 1px solid rgba(246,170,28,.35); background: transparent; color: var(--gold); font-size: 1.4rem; cursor: pointer; }
  .checkout-window h2 { margin: 0; font: 700 1.6rem var(--font-display); }
  .checkout-intro { margin: .45rem 0 1.1rem; color: rgba(255,255,255,.58); font-size: .9rem; }
  .checkout-total { margin-bottom: 1.25rem; }
  .payment-options { display: grid; gap: .55rem; margin: 0; padding: 0; border: 0; }
  .payment-options legend { margin-bottom: .6rem; color: #f1ddb5; font: .68rem var(--font-heading); letter-spacing: .13em; text-transform: uppercase; }
  .payment-option { display: grid; grid-template-columns: 2.2rem 1fr 1rem; gap: .75rem; align-items: center; width: 100%; border: 1px solid rgba(255,255,255,.13); padding: .75rem; background: rgba(255,255,255,.035); color: white; text-align: left; cursor: pointer; transition: border-color .2s, background .2s; }
  .payment-option:hover, .payment-option[aria-pressed="true"] { border-color: var(--gold); background: rgba(246,170,28,.08); }
  .payment-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 4px; background: rgba(255,255,255,.1); color: #fff; font: 700 1.1rem Arial,sans-serif; }
  .paypal-mark { color: #83bfff; font-style: italic; }
  .google-mark { color: #67a8ff; }
  .card-mark { color: var(--gold); }
  .payment-option strong, .payment-option small { display: block; }
  .payment-option strong { font: .82rem var(--font-heading); line-height: 1.35; }
  .payment-option small { margin-top: .25rem; color: rgba(255,255,255,.56); font-size: .74rem; line-height: 1.45; }
  .payment-check { color: var(--gold); opacity: 0; }
  .payment-option[aria-pressed="true"] .payment-check { opacity: 1; }
  .checkout-status { min-height: 2.5rem; margin: 1rem 0; color: #e9c987; font-size: .84rem; line-height: 1.55; }
  .pay-button { justify-content: center; }
  .checkout-footnote { margin: .8rem 0 0; color: rgba(255,255,255,.5); font-size: .72rem; line-height: 1.55; text-align: center; }
  .six-success-dialog { width: min(520px, calc(100vw - 1.5rem)); max-width: none; margin: auto; padding: 0; border: 1px solid rgba(246,170,28,.75); background: #160c07; color: #fff2d7; box-shadow: 0 25px 100px #000c, 0 0 55px #941b0c55; }
  .six-success-dialog[open] { animation: six-dialog-in .28s ease-out both; }
  .six-success-dialog::backdrop { background: rgba(0,0,0,.82); backdrop-filter: blur(7px); }
  .six-success-window { position: relative; display: grid; justify-items: center; padding: clamp(1.5rem, 6vw, 2.7rem); text-align: center; background: radial-gradient(ellipse at center top, #8f2b143b, transparent 65%); }
  .success-rune { color: var(--gold); font: 3.5rem/1 var(--font-display); text-shadow: 0 0 25px #f6aa1c99; animation: rune-glow 2s ease-in-out infinite alternate; }
  .success-kicker { margin: .8rem 0 .5rem; color: var(--gold); font: .7rem var(--font-heading); letter-spacing: .2em; text-transform: uppercase; }
  .success-message { max-width: 24rem; margin: 0; color: #fff1d2; font: 700 clamp(1.35rem, 4vw, 1.8rem)/1.35 var(--font-display); text-shadow: 0 2px 18px #f6aa1c2a; }
  .success-detail { margin: .8rem 0 1.4rem; color: rgba(255,255,255,.66); font-size: .85rem; line-height: 1.6; }
  .success-close { justify-content: center; min-width: 13rem; }
  @keyframes six-dialog-in { from { opacity: 0; transform: translateY(12px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes rune-glow { from { filter: drop-shadow(0 0 4px #f6aa1c66); transform: scale(.96); } to { filter: drop-shadow(0 0 18px #f6aa1ccc); transform: scale(1.04); } }
  @media (max-width: 1000px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .shop-page { padding: 7.5rem 1rem 4rem; }
    .shop-layout { grid-template-columns: 1fr; }
    .cart-panel { position: static; grid-row: 1; }
    .cart-items { max-height: 52vh; }
  }
  @media (max-width: 480px) {
    .product-grid { grid-template-columns: 1fr; }
    .shop-heading { margin-bottom: 2rem; }
    .cart-panel { padding: 1rem; }
    .cart-item-controls { grid-template-columns: 2.6rem minmax(1.6rem, auto) 2.6rem minmax(4.5rem, 1fr); gap: .65rem; }
    .quantity-button { min-width: 2.6rem; min-height: 2.6rem; }
    .remove-button { min-width: 4.5rem; min-height: 2.6rem; padding-inline: .45rem; }
    .payment-option { grid-template-columns: 2.2rem minmax(0, 1fr) 1rem; gap: .65rem; padding: .85rem .7rem; }
    .six-builder-options { grid-template-columns: 1fr; }
    .builder-footer { align-items: stretch; flex-direction: column; }
    .build-six-button { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .shop-product, .add-button, .checkout-button, .build-six-button, .six-success-dialog[open], .success-rune { transition: none; animation: none; } }
</style>

<style is:global>
  /* Las líneas y controles se crean en el navegador, así que necesitan estilos globales. */
  #cart-items .cart-item {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: .25rem .75rem;
    align-items: start;
    padding: .85rem 0;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }
  #checkout-items .checkout-item {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    gap: .65rem;
    align-items: center;
    padding: .7rem 0;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }
  #cart-items .cart-item img, #checkout-items .checkout-item img {
    width: 54px;
    height: 54px;
    object-fit: contain;
    background: rgba(0,0,0,.28);
  }
  #cart-items .cart-item > span:nth-child(2), #checkout-items .checkout-item > span:nth-child(2) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  #cart-items .cart-item-name, #checkout-items .checkout-item-name {
    display: block;
    color: #fff2d7;
    font: 600 .82rem/1.4 var(--font-heading);
  }
  #cart-items .cart-item-meta, #checkout-items .checkout-item-meta {
    display: block;
    margin-top: .25rem;
    color: rgba(255,255,255,.6);
    font-size: .76rem;
    line-height: 1.45;
  }
  #cart-items .cart-item-price {
    grid-column: 2;
    color: var(--gold);
    font: .78rem var(--font-heading);
    white-space: nowrap;
  }
  #checkout-items .checkout-item-price {
    color: var(--gold);
    font: .76rem var(--font-heading);
    white-space: nowrap;
  }
  #cart-items .cart-item-controls {
    display: grid;
    grid-template-columns: 2.5rem minmax(1.5rem, auto) 2.5rem minmax(4.8rem, 1fr);
    grid-column: 1 / -1;
    align-items: center;
    gap: .55rem;
    padding-top: .35rem;
  }
  #cart-items .quantity-button, #cart-items .remove-button {
    display: inline-grid;
    min-width: 2.5rem;
    min-height: 2.5rem;
    place-items: center;
    border: 1px solid rgba(246,170,28,.48);
    border-radius: 4px;
    background: rgba(246,170,28,.08);
    color: #f3ddb0;
    font: 1.1rem var(--font-heading);
    cursor: pointer;
    transition: background .2s, border-color .2s, color .2s, transform .2s;
  }
  #cart-items .quantity-button:hover, #cart-items .quantity-button:focus-visible {
    border-color: var(--gold);
    background: var(--gold);
    color: #201006;
    transform: translateY(-1px);
  }
  #cart-items .cart-quantity {
    min-width: 1.5rem;
    color: #fff2d7;
    font: 600 .86rem var(--font-heading);
    text-align: center;
  }
  #cart-items .remove-button {
    justify-self: end;
    min-width: 4.8rem;
    padding-inline: .65rem;
    border-color: rgba(188,57,8,.56);
    background: rgba(188,57,8,.12);
    color: #e8a18a;
    font: 600 .78rem var(--font-heading);
    letter-spacing: .04em;
  }
  #cart-items .remove-button:hover, #cart-items .remove-button:focus-visible {
    border-color: #e77d63;
    background: rgba(188,57,8,.34);
    color: #fff0e8;
  }
  @media (max-width: 480px) {
    #cart-items .cart-item-controls {
      grid-template-columns: 2.6rem minmax(1.6rem, auto) 2.6rem minmax(4.5rem, 1fr);
      gap: .65rem;
    }
    #cart-items .quantity-button, #cart-items .remove-button { min-height: 2.6rem; }
    #cart-items .quantity-button { min-width: 2.6rem; }
    #cart-items .remove-button { min-width: 4.5rem; padding-inline: .45rem; }
  }
</style>

<script>
  import { shopProducts } from "../data/shop-products";

  type PaymentMethod = "paypal" | "google-pay" | "card";
  type Flavor = "vanir" | "midgard";
  type CartState = Record<string, number>;

  const storageKey = "yggdrasil-special-orders-v1";
  const checkoutEndpoint = import.meta.env.PUBLIC_CHECKOUT_ENDPOINT ?? "";
  const productById = new Map(shopProducts.map((product) => [product.id, product]));
  const cartItems = document.querySelector<HTMLUListElement>("#cart-items");
  const checkoutItems = document.querySelector<HTMLUListElement>("#checkout-items");
  const cartEmpty = document.querySelector<HTMLElement>("#cart-empty");
  const cartCount = document.querySelector<HTMLElement>("#cart-count");
  const cartTotal = document.querySelector<HTMLElement>("#cart-total");
  const checkoutTotal = document.querySelector<HTMLElement>("#checkout-total");
  const priceNote = document.querySelector<HTMLElement>("#price-note");
  const checkoutButton = document.querySelector<HTMLButtonElement>("#open-checkout");
  const checkoutDialog = document.querySelector<HTMLDialogElement>("#checkout-dialog");
  const checkoutStatus = document.querySelector<HTMLElement>("#checkout-status");
  const payButton = document.querySelector<HTMLButtonElement>("#pay-order");
  const closeCheckout = document.querySelector<HTMLButtonElement>("#close-checkout");
  const sixSuccessDialog = document.querySelector<HTMLDialogElement>("#six-success-dialog");
  const closeSixSuccess = document.querySelector<HTMLButtonElement>("#close-six-success");
  const sixSuccessMessage = document.querySelector<HTMLElement>("#six-success-message");
  const sixSuccessDetail = document.querySelector<HTMLElement>("#six-success-detail");
  const packageBuilders = Array.from(document.querySelectorAll<HTMLElement>("[data-package-builder]")).map((element) => ({
    element,
    size: Number(element.dataset.packageSize),
    counts: { vanir: 0, midgard: 0 } as Record<Flavor, number>,
  }));
  let cart: CartState = readCart();
  let selectedMethod: PaymentMethod | null = null;
  let checkoutOpener: HTMLButtonElement | null = null;
  let previousBodyOverflow = "";

  function getProduct(id: string) {
    const standardProduct = productById.get(id);
    if (standardProduct) return standardProduct;
    const match = /^custom-pack-(6|12|24)-(\d+)-(\d+)$/.exec(id);
    if (!match) return undefined;
    const packSize = Number(match[1]);
    const vanir = Number(match[2]);
    const midgard = Number(match[3]);
    if (vanir + midgard !== packSize) return undefined;
    return {
      id,
      name: `Paquete de ${packSize} · ${vanir} VANIR BLUT + ${midgard} MIDGARD`,
      color: vanir > 0 ? "Roja" as const : "Amarilla" as const,
      packSize: packSize as 6 | 12 | 24,
      description: `${vanir} VANIR BLUT y ${midgard} MIDGARD · $85 por lata`,
      image: shopProducts.find((product) => product.id === (vanir > 0 ? "roja-6" : "amarilla-6"))?.image ?? "",
      price: packSize * 85,
    };
  }

  function readCart(): CartState {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) ?? "{}") as Record<string, unknown>;
      const entries = Object.entries(saved).map(([id, quantity]) => {
        const legacySix = /^custom-six-(\d)-(\d)$/.exec(id);
        const migratedId = legacySix ? `custom-pack-6-${legacySix[1]}-${legacySix[2]}` : id;
        return [migratedId, quantity] as const;
      });
      return Object.fromEntries(entries.filter(([id, quantity]) =>
        getProduct(id) && Number.isInteger(quantity) && Number(quantity) > 0,
      ).map(([id, quantity]) => [id, Math.min(Number(quantity), 99)]));
    } catch {
      return {};
    }
  }

  function saveCart() {
    localStorage.setItem(storageKey, JSON.stringify(cart));
  }

  function money(amount: number) {
    return new Intl.NumberFormat("es-MX", { style: "currency", currency: "MXN" }).format(amount);
  }

  function priceFor(productId: string, quantity: number) {
    const price = getProduct(productId)?.price ?? 0;
    return money(price * quantity);
  }

  function makeLineItem(productId: string, quantity: number, editable: boolean) {
    const product = getProduct(productId);
    if (!product) return null;

    const row = document.createElement("li");
    row.className = editable ? "cart-item" : "checkout-item";
    const image = document.createElement("img");
    image.src = product.image;
    image.alt = "";
    image.width = 50;
    image.height = 50;

    const details = document.createElement("span");
    const name = document.createElement("strong");
    name.className = editable ? "cart-item-name" : "checkout-item-name";
    name.textContent = product.name;
    const meta = document.createElement("small");
    meta.className = editable ? "cart-item-meta" : "checkout-item-meta";
    meta.textContent = productId.startsWith("custom-pack-")
      ? `Paquete de ${product.packSize} · ${quantity} ${quantity === 1 ? "paquete" : "paquetes"}`
      : `Caja de ${product.packSize} · ${quantity} ${quantity === 1 ? "caja" : "cajas"}`;
    details.append(name, meta);

    const amount = document.createElement("strong");
    amount.className = editable ? "cart-item-price" : "checkout-item-price";
    amount.textContent = priceFor(productId, quantity);
    row.append(image, details, amount);

    if (editable) {
      const controls = document.createElement("span");
      controls.className = "cart-item-controls";
      const minus = document.createElement("button");
      minus.type = "button";
      minus.className = "quantity-button";
      minus.dataset.cartAction = "decrease";
      minus.dataset.productId = productId;
      minus.setAttribute("aria-label", `Quitar ${productId.startsWith("custom-pack-") ? "un paquete de" : "una caja de"} ${product.name}`);
      minus.textContent = "−";
      const count = document.createElement("span");
      count.className = "cart-quantity";
      count.textContent = String(quantity);
      const plus = document.createElement("button");
      plus.type = "button";
      plus.className = "quantity-button";
      plus.dataset.cartAction = "increase";
      plus.dataset.productId = productId;
      plus.setAttribute("aria-label", `Agregar ${productId.startsWith("custom-pack-") ? "un paquete más de" : "una caja más de"} ${product.name}`);
      plus.textContent = "+";
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "remove-button";
      remove.dataset.cartAction = "remove";
      remove.dataset.productId = productId;
      remove.textContent = "Quitar";
      controls.append(minus, count, plus, remove);
      row.append(controls);
    }
    return row;
  }

  function renderCart() {
    if (!cartItems || !checkoutItems) return;
    const entries = Object.entries(cart).filter(([id, quantity]) => getProduct(id) && quantity > 0);
    const totalUnits = entries.reduce((sum, [, quantity]) => sum + quantity, 0);
    const subtotal = entries.reduce((sum, [id, quantity]) => sum + (getProduct(id)?.price ?? 0) * quantity, 0);

    cartItems.replaceChildren();
    checkoutItems.replaceChildren();
    entries.forEach(([id, quantity]) => {
      const cartRow = makeLineItem(id, quantity, true);
      const checkoutRow = makeLineItem(id, quantity, false);
      if (cartRow) cartItems.append(cartRow);
      if (checkoutRow) checkoutItems.append(checkoutRow);
    });

    if (cartEmpty) cartEmpty.hidden = entries.length > 0;
    if (cartCount) cartCount.textContent = String(totalUnits);
    if (cartTotal) cartTotal.textContent = money(subtotal);
    if (checkoutTotal) checkoutTotal.textContent = money(subtotal);
    if (priceNote) priceNote.textContent = "Precio unitario: $85 MXN por lata. Importes en pesos mexicanos.";
    if (checkoutButton) checkoutButton.disabled = entries.length === 0;
    saveCart();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.addToCart;
      if (!id || !productById.has(id)) return;
      cart[id] = Math.min((cart[id] ?? 0) + 1, 99);
      renderCart();
      button.textContent = "Añadido al carrito ✓";
      window.setTimeout(() => { button.textContent = "Añadir al carrito ＋"; }, 1100);
    });
  });

  function updatePackageBuilder(builder: typeof packageBuilders[number]) {
    const total = builder.counts.vanir + builder.counts.midgard;
    builder.element.querySelector<HTMLOutputElement>('[data-count="vanir"]')!.value = String(builder.counts.vanir);
    builder.element.querySelector<HTMLOutputElement>('[data-count="midgard"]')!.value = String(builder.counts.midgard);
    const progress = builder.element.querySelector<HTMLElement>("[data-package-progress]");
    const buildButton = builder.element.querySelector<HTMLButtonElement>("[data-build-package]");
    if (progress) progress.textContent = `${total} de ${builder.size} latas seleccionadas · $${total * 85} MXN`;
    if (buildButton) buildButton.disabled = total !== builder.size;
    builder.element.querySelectorAll<HTMLButtonElement>("[data-package-flavor][data-step]").forEach((button) => {
      const flavor = button.dataset.packageFlavor as Flavor;
      const step = Number(button.dataset.step);
      button.disabled = step > 0 ? total >= builder.size : builder.counts[flavor] <= 0;
    });
  }

  packageBuilders.forEach((builder) => {
    builder.element.querySelectorAll<HTMLButtonElement>("[data-package-flavor][data-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const flavor = button.dataset.packageFlavor as Flavor;
        const step = Number(button.dataset.step);
        const total = builder.counts.vanir + builder.counts.midgard;
        if (step > 0 && total >= builder.size) return;
        builder.counts[flavor] = Math.max(0, builder.counts[flavor] + step);
        updatePackageBuilder(builder);
      });
    });
    builder.element.querySelector<HTMLButtonElement>("[data-build-package]")?.addEventListener("click", () => {
      const total = builder.counts.vanir + builder.counts.midgard;
      if (total !== builder.size) return;
      const id = `custom-pack-${builder.size}-${builder.counts.vanir}-${builder.counts.midgard}`;
      cart[id] = Math.min((cart[id] ?? 0) + 1, 99);
      renderCart();
      if (sixSuccessMessage) sixSuccessMessage.textContent = `Perfecto Vikingo, has armado tu paquete de ${builder.size} latas de la bebida de los Dioses`;
      if (sixSuccessDetail) sixSuccessDetail.textContent = `${builder.counts.vanir} VANIR BLUT + ${builder.counts.midgard} MIDGARD · $${builder.size * 85} MXN. Ya lo agregamos a tu carrito.`;
      sixSuccessDialog?.showModal();
      closeSixSuccess?.focus();
    });
    updatePackageBuilder(builder);
  });

  closeSixSuccess?.addEventListener("click", () => sixSuccessDialog?.close());
  sixSuccessDialog?.addEventListener("click", (event) => {
    if (event.target === sixSuccessDialog) sixSuccessDialog.close();
  });
  sixSuccessDialog?.addEventListener("close", () => document.querySelector<HTMLButtonElement>("[data-build-package]:not(:disabled)")?.focus());

  cartItems?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cart-action]");
    if (!button) return;
    const id = button.dataset.productId;
    const action = button.dataset.cartAction;
    if (!id || !cart[id]) return;
    if (action === "increase") cart[id] = Math.min(cart[id] + 1, 99);
    if (action === "decrease") cart[id] -= 1;
    if (action === "remove" || cart[id] <= 0) delete cart[id];
    renderCart();
  });

  checkoutButton?.addEventListener("click", () => {
    if (!checkoutDialog) return;
    checkoutOpener = checkoutButton;
    renderCart();
    selectedMethod = null;
    document.querySelectorAll<HTMLButtonElement>("[data-payment-method]").forEach((button) => button.setAttribute("aria-pressed", "false"));
    if (checkoutStatus) checkoutStatus.textContent = "Elige una forma de pago. Los cargos no se procesan hasta configurar la conexión segura.";
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    checkoutDialog.showModal();
    closeCheckout?.focus();
  });

  closeCheckout?.addEventListener("click", () => checkoutDialog?.close());
  checkoutDialog?.addEventListener("click", (event) => {
    if (event.target === checkoutDialog) checkoutDialog.close();
  });
  checkoutDialog?.addEventListener("close", () => {
    document.body.style.overflow = previousBodyOverflow;
    checkoutOpener?.focus();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-payment-method]").forEach((button) => {
    button.addEventListener("click", () => {
      selectedMethod = button.dataset.paymentMethod as PaymentMethod;
      document.querySelectorAll<HTMLButtonElement>("[data-payment-method]").forEach((option) => {
        option.setAttribute("aria-pressed", String(option === button));
      });
      if (checkoutStatus) checkoutStatus.textContent = `${button.querySelector("strong")?.textContent} seleccionado. Para procesar el cobro falta conectar el checkout seguro.`;
    });
  });

  payButton?.addEventListener("click", async () => {
    if (!selectedMethod || !checkoutStatus || !payButton) {
      if (checkoutStatus) checkoutStatus.textContent = "Selecciona primero una forma de pago.";
      return;
    }
    const entries = Object.entries(cart).filter(([, quantity]) => quantity > 0);
    if (!checkoutEndpoint) {
      checkoutStatus.textContent = "La tienda y el resumen de compra ya funcionan. Para recibir pagos reales falta conectar un endpoint seguro y las cuentas del proveedor.";
      return;
    }

    payButton.disabled = true;
    payButton.textContent = "Conectando con el proveedor…";
    checkoutStatus.textContent = "Preparando una sesión de pago segura…";
    try {
      const response = await fetch(checkoutEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ method: selectedMethod, items: entries.map(([id, quantity]) => ({ id, quantity })) }),
      });
      if (!response.ok) throw new Error("El servicio de pagos no pudo iniciar el checkout.");
      const result = await response.json() as { checkoutUrl?: string };
      if (!result.checkoutUrl) throw new Error("El servicio no devolvió una dirección de pago.");
      const checkoutUrl = new URL(result.checkoutUrl, window.location.origin);
      if (checkoutUrl.protocol !== "https:" && checkoutUrl.origin !== window.location.origin) {
        throw new Error("La dirección de pago debe usar HTTPS.");
      }
      window.location.assign(checkoutUrl.href);
    } catch (error) {
      checkoutStatus.textContent = error instanceof Error ? error.message : "No se pudo iniciar el pago. Inténtalo más tarde.";
      payButton.disabled = false;
      payButton.textContent = "Continuar al pago seguro";
    }
  });

  renderCart();
</script>
